# ─── Credenciales y datos personales: NUNCA publicar ───
config_email.json
config_local.json

# ─── Base de datos: contiene los correos de los suscriptores ───
*.db
revistas.db

# ─── Datos descargados de terceros ───
# Se versionan las fuentes chicas que el panel necesita para reconstruirse
# (rankings de SCImago, relevamientos de sitios): sin ellas, el robot de
# GitHub Actions arma un catálogo incompleto.
# Queda afuera scopus_source_list.xlsx, que son ~26 MB de Elsevier y no se
# redistribuye: indizacion.py lo descarga solo.
datos/*
!datos/*.csv
!datos/*.docx

# ─── Salidas generadas ───
informes/
*.log
ejecutar-actualizacion.bat
ejecutar-resolver-issn.bat

# ─── Python ───
venv/
.venv/
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# ─── Editores / sistema ───
.streamlit/
.env
.vscode/
.idea/
.DS_Store
Thumbs.db

# Perfil de Chrome del navegador asistido: cookies y sesion.
perfil-revistas/

# Capturas y HTML que deja el navegador cuando una pagina no se libera.
diagnostico/
